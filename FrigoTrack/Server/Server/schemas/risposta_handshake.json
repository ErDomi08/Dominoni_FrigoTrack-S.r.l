{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Risposta Handshake",
  "type": "object",
  "required": ["session_id", "server"],
  "properties": {
    "session_id": { 
      "type": "string", 
      "pattern": "^[a-f0-9]{8}$" 
    },
    "server": { "type": "string", "pattern": "^[0-9]+$" }
  },
  "additionalProperties": false
}
