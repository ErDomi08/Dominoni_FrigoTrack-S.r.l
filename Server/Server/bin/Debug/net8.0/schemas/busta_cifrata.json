{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["session_id", "testo_cifrato", "tag"],
  "properties": {
    "session_id": { 
      "type": "string", 
      "pattern": "^[a-f0-9]{8}$" 
    },
    "testo_cifrato": { 
      "type": "string" 
    },
    "tag": { 
      "type": "string" 
    }
  },
  "additionalProperties": false
}